{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./init.sh > /tmp/harness_init.log 2>&1 && echo '[harness] init.sh OK' || (echo '[harness] init.sh FAILED — see /tmp/harness_init.log' && tail -20 /tmp/harness_init.log)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null || exit 0; in=$(cat); set --; for k in agent_transcript_path transcript_path; do p=$(printf '%s' \"$in\" | jq -r --arg k \"$k\" '.[$k] // empty' 2>/dev/null); [ -n \"$p\" ] && set -- \"$@\" --transcript \"$p\"; done; [ -f scripts/harness.sh ] && bash scripts/harness.sh record-usage \"$@\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
